/* Longest common subsequence and 0/1 knapsack, both by dynamic programming. */

int max(int a, int b) {
  return a > b ? a : b;
}

int lcs(int[] a, int[] b) {
  int n = length(a, 0);
  int m = length(b, 0);
  int[][] dp = new int[n + 1][m + 1];
  for (int i = 1; i <= n; i++) {
    for (int j = 1; j <= m; j++) {
      if (a[i - 1] == b[j - 1]) dp[i][j] = dp[i - 1][j - 1] + 1;
      else dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
    }
  }
  return dp[n][m];
}

int knapsack(int[] weight, int[] value, int capacity) {
  int[] best = new int[capacity + 1];
  for (int k = 0; k < length(weight, 0); k++) {
    for (int c = capacity; c >= weight[k]; c--) {
      best[c] = max(best[c], best[c - weight[k]] + value[k]);
    }
  }
  return best[capacity];
}

int[] sequence(int n, int seed, int modulus) {
  int[] s = new int[n];
  for (int i = 0; i < n; i++) {
    seed = (seed * 75 + 74) % 65537;
    s[i] = seed % modulus;
  }
  return s;
}

void main() {
  print(lcs(sequence(60, 7, 5), sequence(70, 11, 5)));
  int[] w = sequence(20, 3, 30);
  int[] v = sequence(20, 5, 100);
  for (int i = 0; i < 20; i++) w[i] += 1;
  print(knapsack(w, v, 100));
}
