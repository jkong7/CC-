#!/usr/bin/env bash
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

FILTER="${1:-}"
LEVELS="${OPT_LEVELS:-0 1}"
ATTEMPTS=1
[ "${CC_EMULATED:-0}" = 1 ] && ATTEMPTS=3

retry() {
  local attempt status
  for attempt in $(seq 1 "$ATTEMPTS"); do
    "$@"
    status=$?
    [ "$status" -lt 128 ] && return "$status"
  done
  return "$status"
}
PASS=0
FAIL=0
FAILED=()

compile_to() {
  "$ROOT/scripts/compile" "$@" > "$WORK/compile.log" 2>&1
  local status=$?
  if [ "$status" -ne 0 ] && grep -qE "Segmentation fault|internal compiler error" "$WORK/compile.log"; then
    return 139
  fi
  return "$status"
}

run_program() {
  timeout 10 "$exe" < "$input" > "$WORK/actual" 2>&1
  local status=$?
  if [ "$status" -ge 128 ] && [ -s "$WORK/actual" ] && diff -q "$expected" "$WORK/actual" > /dev/null; then
    return 0
  fi
  return "$status"
}

for expected in $(find "$ROOT/tests" -name "*.out" | sort); do
  source="${expected%.out}"
  [ -f "$source" ] || continue
  name="${source#$ROOT/tests/}"
  case "$name" in
    *"$FILTER"*) ;;
    *) continue ;;
  esac

  exe="$WORK/prog"
  input="/dev/null"
  [ -f "$source.in" ] && input="$source.in"

  for level in $LEVELS; do
    label="$name -O$level"
    if ! retry compile_to -O "$level" -o "$exe" "$source"; then
      FAIL=$((FAIL + 1)); FAILED+=("$label (compile)")
      printf "FAIL %s (compile)\n" "$label"
      sed 's/^/     /' "$WORK/compile.log" | tail -n 5
      continue
    fi

    retry run_program
    if diff -q "$expected" "$WORK/actual" > /dev/null; then
      PASS=$((PASS + 1))
      printf "ok   %s\n" "$label"
    else
      FAIL=$((FAIL + 1)); FAILED+=("$label")
      printf "FAIL %s\n" "$label"
      diff "$expected" "$WORK/actual" | head -n 10 | sed 's/^/     /'
    fi
  done
done

for expected in $(find "$ROOT/tests" -name "*.err" | sort); do
  source="${expected%.err}"
  [ -f "$source" ] || continue
  name="${source#$ROOT/tests/}"
  case "$name" in
    *"$FILTER"*) ;;
    *) continue ;;
  esac

  if retry compile_to -o "$WORK/prog" "$source"; then
    FAIL=$((FAIL + 1)); FAILED+=("$name (compiled)")
    printf "FAIL %s (expected a compile error)\n" "$name"
    continue
  fi

  grep -E ": (error|warning): " "$WORK/compile.log" | sed "s|$ROOT/||" > "$WORK/actual"
  if diff -q "$expected" "$WORK/actual" > /dev/null; then
    PASS=$((PASS + 1))
    printf "ok   %s\n" "$name"
  else
    FAIL=$((FAIL + 1)); FAILED+=("$name")
    printf "FAIL %s\n" "$name"
    diff "$expected" "$WORK/actual" | head -n 10 | sed 's/^/     /'
  fi
done

echo
echo "$PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ]
