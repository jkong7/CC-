void main() {
  int n = 160;
  int[][] a = new int[n][n];
  int[][] b = new int[n][n];
  int[][] c = new int[n][n];
  for (int i = 0; i < n; i++) {
    for (int j = 0; j < n; j++) {
      a[i][j] = (i * 7 + j) & 15;
      b[i][j] = (i + j * 3) & 15;
    }
  }
  for (int i = 0; i < n; i++) {
    for (int j = 0; j < n; j++) {
      int sum = 0;
      for (int k = 0; k < n; k++) sum += a[i][k] * b[k][j];
      c[i][j] = sum;
    }
  }
  int trace = 0;
  for (int i = 0; i < n; i++) trace += c[i][i];
  print(trace);
}
