(@main
  (@main 0
    %a <- 1
    %b <- 2
    %c <- 3
    %d <- 4
    %e <- 5
    %f <- 6
    %g <- 7
    %h <- 8
    %i <- 9
    %j <- 10
    %k <- 11
    %l <- 12
    %m <- 13
    %n <- 14
    %o <- 15
    %p <- 16
    %q <- 17
    %r <- 18
    rdi <- 3
    call print 1
    %s <- %a
    %s += %b
    %s += %c
    %s += %d
    %s += %e
    %s += %f
    %s += %g
    %s += %h
    %s += %i
    %s += %j
    %s += %k
    %s += %l
    %s += %m
    %s += %n
    %s += %o
    %s += %p
    %s += %q
    %s += %r
    %t <- %a
    %t *= %r
    %s += %t
    %s <<= 1
    %s++
    rdi <- %s
    call print 1
    return
  )
)
