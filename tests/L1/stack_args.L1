(@main
  (@main 0 0
    rdi <- 1
    rsi <- 2
    rdx <- 3
    rcx <- 4
    r8 <- 5
    r9 <- 6
    mem rsp -8 <- :sum8_ret
    mem rsp -16 <- 7
    mem rsp -24 <- 8
    call @sum8 8
    :sum8_ret
    rdi <- rax
    rdi <<= 1
    rdi++
    call print 1
    return
  )
  (@sum8 8 1
    rax <- rdi
    rax += rsi
    rax += rdx
    rax += rcx
    rax += r8
    rax += r9
    r10 <- mem rsp 16
    rax += r10
    r10 <- mem rsp 8
    rax += r10
    mem rsp 0 <- rax
    rax <- mem rsp 0
    return
  )
)
