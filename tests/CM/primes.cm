/* Sieve of Eratosthenes, then a few checks on the result. */

int[] sieve(int n) {
  int[] composite = new int[n + 1];
  for (int i = 2; i * i <= n; i++) {
    if (composite[i] == 0) {
      for (int j = i * i; j <= n; j += i) {
        composite[j] = 1;
      }
    }
  }
  return composite;
}

int count(int[] composite) {
  int total = 0;
  int n = length(composite, 0);
  for (int i = 2; i < n; i++) {
    if (!composite[i]) total++;
  }
  return total;
}

void main() {
  int[] c = sieve(100);
  print(count(c));
  int printed = 0;
  int i = 2;
  while (printed < 10) {
    if (c[i] == 0) {
      print(i);
      printed += 1;
    }
    i++;
  }
  print(c[97] == 0 && c[91] != 0);
}
